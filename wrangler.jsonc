{
  "name": "ostrelya-main",
  "main": "redesign/tools/locale_worker.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "send_email": [{ "name": "CONTACT_MAIL", "allowed_sender_addresses": ["hello@ostrelya.com"] }],
  "ratelimits": [
    { "name": "CONTACT_LIMIT", "namespace_id": "764230", "simple": { "limit": 3, "period": 60 } },
    { "name": "CONTACT_BUDGET", "namespace_id": "764231", "simple": { "limit": 20, "period": 60 } }
  ],
  "build": {
    "command": "python -B deployment/build.py"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/api/locale", "/api/enquiry"]
  }
}
